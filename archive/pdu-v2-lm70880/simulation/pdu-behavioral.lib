* Engineering approximations for topology tests. NOT Texas Instruments models.
* Same file for LTspice and ngspice. Numeric constants are nominal assumptions.
.model PDU_SCHOTTKY D(Is=20u N=1.1 Rs=30m Bv=40 Ibv=1m)
.model PDU_TVS D(Is=1n N=1.5 Rs=0.59 Bv=36.7 Ibv=1m)
.model PDU_BODY D(Is=1u N=1.3 Rs=20m Bv=100 Ibv=1m)
.model PDU_QSW SW(Ron=16m Roff=1e12 Vt=2 Vh=0.1)
.model PDU_BUCK_UVLO SW(Ron=1 Roff=1T Vt=0.95 Vh=0.05)
.model PDU_EFUSE_UVLO SW(Ron=1 Roff=1T Vt=1.15 Vh=0.05)

.subckt PDU_Q1 S1 S2 S3 G D
Bq D S1 I=V(D,S1)*(1p+62.5*min(max((V(G,S1)-1)/3,0),1))
Dbody S1 D PDU_BODY
.ends PDU_Q1

.subckt PDU_IDEAL_DIODE VCAP GND EN CATHODE GATE ANODE
* Approximate reverse-current comparison and gate bias; no propagation model.
Bgate ANODE GATE I=(10*min(max((V(EN,GND)-3.2)/0.2,0),1)*min(max((V(ANODE,CATHODE)+0.02)/0.02,0),1)-V(GATE,ANODE))/10
Cgate GATE ANODE 10n
Rgate GATE ANODE 10Meg
Bcap ANODE VCAP I=(10-V(VCAP,ANODE))/10k
Rcap VCAP ANODE 1T
.ends PDU_IDEAL_DIODE

.subckt PDU_BUCK P1 P2 P3 P4 P5 P6 P7 P8 P9 P10 P11 P12 P13 P14 P15 P16 P17 P18 P19 P20 P21 P22 P23 P24 P25 P26 P27 P28 P29 P30 MAIN=1 RSVAL=7.5m
* External COMP and actual shunt voltage control the average SW source.
* 500 V/V current-error gain is an explicit approximation, NOT TI inner loop.
Vone one P17 1
Suvlo one ena P9 P17 PDU_BUCK_UVLO
Rena ena P17 1Meg
* Nominal soft-start restarts on every enable; no absolute-time shortcut.
Css ss P17 1n
Rss ss P17 1T
Bss P17 ss I=if(V(ena,P17)>0.5,min(0.8*1n/2.8m,(0.8-V(ss,P17))/100),-V(ss,P17)/100)
Bgm P17 P15 I={MAIN}*if(V(ena,P17)>0.5,min(max(1200u*(V(ss,P17)-V(P16,P17)),-170u),170u),-V(P15,P17)/10k)
Roa P15 P17 64Meg
Cbw P15 P17 {MAIN*38p+1f}
Bsw P20 P17 V=if(V(ena,P17)>0.5,min(max(V(P12,P17)+500*(min(max(V(P15,P17)/10,0),0.056)-V(P11,P12)),0),max(V(P1,P17),0)),0)
Rsw4 P5 P20 1m
Bvcc P17 P19 I=(if(V(ena,P17)>0.5,8,0)-V(P19,P17))/1
Bvdda P17 P18 I=(if(V(ena,P17)>0.5,5,0)-V(P18,P17))/1
Bboot P17 P4 I=(V(P5,P17)+V(P19,P17)-V(P4,P17))/100
Rbootleak P4 P17 1T
Rvccleak P19 P17 1T
Rvddaleak P18 P17 1T
* Input power approximation; no validated switching or efficiency model.
Binput P1 P17 I=max(V(P11,P12)/{RSVAL},0)*max(V(P20,P17),0)/max(V(P1,P17),1)
Rcfg P13 P17 1T
Rrt P14 P17 1T
Rnc P10 P17 1T
.ends PDU_BUCK

.subckt PDU_EFUSE P1 P2 P3 P4 P5 P6 P7 P8 P9 P10 P11 P12 P13 P14 P15 P16 P17 P18 P19 P20 P21 P22 P23 P24 P25 P26 RLIM=301
* Nominal O-variant circuit breaker with latch, not active current limiter.
.param ITRIP={1460/RLIM+0.11}
Vsense P1 path 0
Vone one P4 1
Suvlo one uv P6 P4 PDU_EFUSE_UVLO
Ruv uv P4 1Meg
Bena ena P4 V=if(V(uv,P4)>0.5,if(V(P1,P4)<16.9,if(V(latch,P4)<0.5,1,0),0),0)
* Startup slew limiting ends once output catches input. A later input rise
* must not incorrectly restart the startup ramp and hide an OVP excursion.
Bdone P4 done I=if(V(ena,P4)<0.5,-V(done,P4)/100,if(V(P15,P4)>V(P1,P4)-0.02,if(V(done,P4)<1,1m,0),0))
Cdone done P4 1n IC=0
Rdone done P4 1T
Btrip P4 latch I=if(V(P6,P4)<0.8,-V(latch,P4)/100,if(V(done,P4)>0.5,if(I(Vsense)>{ITRIP},if(V(latch,P4)<1,1m,0),0),0))
Clatch latch P4 1n IC=0
Rlatch latch P4 1T
Bdv P4 P15 I=if(V(ena,P4)>0.5,min(4.6u,V(P1,P15)/1000),-V(P15,P4)/100)
Rdvleak P15 P4 1T
* Startup: ideal nominal ILIM; normal operation: breaker after 0.5us latch delay.
* No SOA/thermal/foldback or silicon timing claim is made.
Bpath path P17 I=if(V(ena,P4)>0.5,min(max((V(path,P17)-if(V(done,P4)>0.5,0,max(V(P1,P15),0)))/2.7m,-2.1*{ITRIP}),if(V(done,P4)>0.5,2.1*{ITRIP},{ITRIP})),V(path,P17)/1T)
Bpg P13 P4 I=if(V(ena,P4)>0.5,if(V(P1,P17)<0.326,0,V(P13,P4)/10),V(P13,P4)/10)
Bmon P4 P9 I=246u*max(I(Vsense),0)
Rimonleak P9 P4 1T
Ritimer P7 P4 1T
Rilim P8 P4 1T
.ends PDU_EFUSE
