# LTspice generated waveforms and caches
*.raw
*.db
*.log.raw
*.op.raw

# Python cache
__pycache__/
*.py[cod]

# KiCad local settings
*.kicad_prl

# KiCad/editor session state (keep locally; never delete locks to bypass editors)
*.lck
*.bak
*.kicad_sch-bak
*.kicad_pcb-bak
*-backups/
.history/
_autosave-*

# Downloaded manufacturer data/models: obtain from the documented official URLs.
# TDK models explicitly prohibit redistribution without permission.
hardware/_datasheets/
hardware/validation/c5750/*.mod
hardware/validation/c5750/readme_ltspice_en.txt

# Machine-specific MCP endpoint configuration and replayable transient requests
.konnect/diagnostics/*config*.json
.konnect/diagnostics/*pid*.txt
.konnect/diagnostics/*-calls*.json
.konnect/diagnostics/reapply-routing-*.json
.konnect/diagnostics/*-audit.txt

# Failed convergence generated a29MB diagnostic; retain locally, summarize in reports
simulation/candidate-global-startup-one-hot-r2.log

# Local isolated UVLO ngspice runs are immutable evidence; never add generated logs automatically.
simulation/proposals/2026-10-25-uvlo/results/runs/
