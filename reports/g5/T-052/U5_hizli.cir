* T-052 isolated charge pump U5_hizli
.param IP=0.0006 C=9e-08 VSTOP=13.0 CG=1.923076923076923e-09 TG=0.0039000000000000003
BCP 0 vcap I = {IP}*min(max(({VSTOP}-V(vcap))/10m,0),1)*(1-(time>{TG}))
CV vcap 0 {C} IC=0
SW1 vcap g ctrl 0 SWG
.model SWG SW(Ron=1 Roff=1e9 Vt=0.5 Vh=0.01)
VC ctrl 0 PWL(0 0 {TG} 0 {TG*1.001} 1)
CGL g 0 {CG} IC=0
RGL g 0 1G
.tran 4.875e-07 0.00468 0 4.875e-07 UIC
.meas tran tuv WHEN V(vcap)=5.8 RISE=1
.meas tran vpre FIND V(vcap) AT=0.0038610000000000003
.meas tran vend FIND V(vcap) AT=0.004641
.end
