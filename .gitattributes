* text=auto eol=lf

# Preserve exact serialized CAD bytes; Git must not rewrite these on checkout.
*.kicad_sch -text
*.kicad_pcb -text
*.kicad_pro -text
*.kicad_sym -text
*.kicad_mod -text
fp-lib-table -text
sym-lib-table -text

# Historical tracked learning sheet keeps its original normalized Git representation.
/hardware/functional-blocks.kicad_sch text eol=crlf

# Recorded evidence hashes refer to exact exported/model bytes.
*.net -text
/simulation/pdu-circuit.inc -text
/simulation/pdu-behavioral.lib -text
/simulation/pdu-inductor-lt.lib -text
/simulation/pdu-inductor-ng.lib -text
/hardware/pdu-current-bom.csv -text
/hardware/pdu-current-bom.raw.csv -text
/hardware/validation/c5750/vendor-ac-summary.json -text

# G3: archived evidence keeps exact committed bytes (MANIFEST-SHA256 refers to them).
/archive/** -text
/simulation/pdu-efuse-ovp.ng.cir -text
